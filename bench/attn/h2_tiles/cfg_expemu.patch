--- a/csrc/qattn/attn_utils.cuh
+++ b/csrc/qattn/attn_utils.cuh
@@ -24,6 +24,29 @@
 #include "../mma.cuh"
 #include "../permuted_smem.cuh"
 #include "../numeric_conversion.cuh"
+#include "h2_tiles.h"  // SAGE_H2_EXP_EMU, SAGE_H2_EXP_EMU_FRACTION
+
+#ifdef SAGE_H2_EXP_EMU
+// 2^x on the FMA/ALU pipes instead of MUFU (FlashAttention-4 style software exp2).
+// n = rint(x) via the 1.5*2^23 magic add (no F2I, which would also go to the XU/MUFU pipe), f = x - n in
+// [-0.5, 0.5], 2^f by a degree-3 minimax polynomial (Remez, max relative error 7.5e-5 = 2^-13.7 in fp32
+// Horner), then 2^n by adding n to the exponent bits. 9 FMA-pipe ops per element (FMNMX, 3 FADD, 3 FFMA,
+// SHL, IADD) vs one MUFU op. Callers pass x <= 8.807 (max-subtracted, +S_FP8_OFFSET); x is clamped at -125 so
+// the result is always a normal float (2^-125 -> 0 after the e4m3 conversion, same as ex2.approx.ftz's 0).
+__forceinline__ __device__ float exp2_poly(float x)
+{
+  x = fmaxf(x, -125.0f);
+  const float t = __fadd_rn(x, 12582912.0f);   // 1.5 * 2^23: low mantissa bits of t hold rint(x)
+  const float n = __fadd_rn(t, -12582912.0f);
+  const float f = x - n;                       // exact, in [-0.5, 0.5]
+  float p = fmaf(5.517166853e-02f, f, 2.426111251e-01f);
+  p = fmaf(p, f, 6.932609677e-01f);
+  p = fmaf(p, f, 9.999280572e-01f);
+  // t's low mantissa bits hold rint(x) in two's complement; shifting them into the exponent scales p by 2^n.
+  // Unsigned shift: a signed left shift of a negative value is UB (the red-team of this patch, §19).
+  return __int_as_float((int)(__float_as_uint(p) + (__float_as_uint(t) << 23)));
+}
+#endif
 
 #define WARP_SIZE 32
 
@@ -435,6 +458,35 @@ __device__ __forceinline__ void update_mdo(float RS[][num_tiles_k][8], DTypeSVAc
 
       // raise RS to exponent
