+#ifdef SAGE_H2_EXP_EMU
+      // same 4 elements per fragment as below (k*2 + {0,1,4,5}); element index fk*4+j selects the exp2 unit
+#pragma unroll
+      for (uint32_t fk = 0; fk < num_tiles_k; fk++)
+      {
+#pragma unroll
+        for (uint32_t j = 0; j < 4; j++)
+        {
+          const uint32_t e = k * 2 + (j & 1) + ((j & 2) << 1);
+          float x;
+          if constexpr (fuse_scale)
+          {
+            x = RS[fq][fk][e] + negative_m;
+          }
+          else
+          {
+            x = fmaf(RS[fq][fk][e], sm_scale, negative_m);
+          }
+          if ((fk * 4 + j) % SAGE_H2_EXP_EMU_FRACTION == 0)
+          {
+            RS[fq][fk][e] = exp2_poly(x);
+          }
+          else
+          {
+            RS[fq][fk][e] = math::ptx_exp2(x);
+          }
+        }
+      }
+#else
 #pragma unroll
       for (uint32_t fk = 0; fk < num_tiles_k; fk++)
       {
@@ -453,6 +505,7 @@ __device__ __forceinline__ void update_mdo(float RS[][num_tiles_k][8], DTypeSVAc
