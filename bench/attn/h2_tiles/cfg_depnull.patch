diff --git a/csrc/qattn/h2_tiles.h b/csrc/qattn/h2_tiles.h
new file mode 100644
index 0000000..33dd50f
--- /dev/null
+++ b/csrc/qattn/h2_tiles.h
@@ -0,0 +1,173 @@
+// ===========================================================================================
+// cfg_depnull -- decisive follow-up to cfg_fixedmax_dep (see OPTIMIZATIONS.md #20, "Decomposition
+// of the softmax's 13%: attempted, and retracted"). cfg_fixedmax_dep tried to split C5's 8.7%
+// into "serial dependency" vs "removed ALU work" by putting a SHALLOW SURROGATE dependency (2
+// shuffles seeded from ONE S fragment, ~6 instructions deep) back in FRONT of C5's exp2. Its
+// reviewer rejected the split: that surrogate chain roots in a different S fragment than
+// update_mdo's real max (fk=0 only, not all num_tiles_k fragments) and is a different number of
+// dependent instructions deep (~6 vs ~20), and restructuring update_mdo's fused max+exp loop into
+// two passes is itself a confound.
+//
+// cfg_depnull inverts the design to sidestep both objections: it computes update_mdo's REAL row
+// max -- the exact same fk loop over every S fragment, the exact same two __shfl_xor_sync, the
+// exact same exp_offset=true/fuse_scale=false pre-shuffle fmaf, so same fragment identity and
+// same ~15-20 instruction depth as cfg_base's real chain -- but the result is sunk through a
+// volatile-asm barrier and never reaches RS, m, or d. C5's already-existing flat fq/fk/e exp2 loop
+// (apply_fixed_max, unchanged from cfg_fixedmax) runs alongside it, completely data-independent.
+// So: same ALU work and same dependency SHAPE as cfg_base's real chain, but no dependency EDGE
+// into the exp2. Read bench/attn/h2_tiles/README.md's cfg_depnull section for the prediction
+// table and the residual confound this does NOT resolve (ptxas is free to hide a disconnected
+// chain in ways it cannot hide one that gates a real consumer -- a "no slowdown" result is an
+// upper bound on recoverable savings, not proof a real two-pass restructure achieves it).
+// ===========================================================================================
+//
+// cfg_fixedmax -- candidate C5: fixed global max (FlashDecoding++, arXiv 2311.01282, "unified
+// max value phi") on top of cfg_base's tile mechanism (tiles unchanged: 128/64/32/64).
+//
+// WHY. Deleting the whole softmax from this kernel is worth 13% (1.742 -> 1.518 ms on a 5090).
+// Making exp2 cheaper bought 0%; skipping the O rescale bought 0%. What is left is the SERIAL
+// DEPENDENCY per K tile: int32 S -> __int2float_rz -> row max -> 2 __shfl_xor_sync -> negative_m
+// -> exp2 -> row sum -> fp8 pack, all of which must retire before the next tile's mma.sync can
+// issue (mma.sync is synchronous, 4 warps/CTA, 1-2 CTAs/SM, so there is nothing else to run).
+// C5 removes the head of that chain: with a CONSTANT upper bound phi there is no row max, no
+// shuffle, no m state, no o_scale and no RO rescale. exp2 now depends only on the element itself,
+// so the 8 exp2 of a fragment are independent and the tile's fp8 pack no longer waits on a
+// cross-lane reduction.
+//
+// MATH. Upstream computes  m = rowmax(S*scale) - S_FP8_OFFSET,  P = exp2(S*scale - m),
+// d = sum_j P,  O = (sum_j P_j V_j) / d. C5 sets m := phi - S_FP8_OFFSET for every row, i.e.
+//   P = exp2(S*scale - phi + S_FP8_OFFSET)
+// The row-independent factor 2^(S_FP8_OFFSET - phi) appears in both the numerator (through O) and
+// the denominator (through d) and cancels exactly in the epilogue division, so in exact arithmetic
+// the result is IDENTICAL to upstream. LSE stays correct too: log2(d) + m with the constant m.
+//
+// NUMERICS. The only difference from upstream is the fp8 quantisation grid that P lands on: P is
+// now scaled by a fixed factor instead of a per-row one. A row whose true max is G (base-2 octaves)
+// below phi has all of its P values 2^-G smaller than upstream would make them, so:
+//   * the row's largest P is 448 * 2^-G instead of 448;
+//   * e4m3 is normal down to 2^-6 and subnormal to 2^-9, so upstream keeps ~18.8 octaves of
+//     dynamic range below the row max and C5 keeps ~(18.8 - G); anything further below the row
+//     max flushes to zero, and entries under 2^-6 lose mantissa bits (2 bits at 2^-7, 1 at 2^-8,
+//     0 at 2^-9) instead of e4m3's usual 3.
+// One asymmetry makes this sharper than it looks: d is accumulated by accumulate_d from RS_f32,
+// i.e. from P BEFORE the fp8 pack, while the numerator O sees P AFTER RS_32_to_8. Upstream keeps
+// the row max pinned at 448 so little of the row is subnormal and the two agree closely. Under
+// C5 a row with large G pushes mass into e4m3 subnormals / zero in the NUMERATOR only, while the
+// DENOMINATOR keeps it in fp32 -- so O / d is biased low for exactly the rows that are far from
+// phi. Expect the error to show up as a systematic shrink of low-max rows, not as noise.
+// So THE QUALITY RISK IS ROWS WHOSE TRUE MAX IS FAR BELOW phi, and it must be MEASURED (cosine /
+// max-abs vs fp32 SDPA in bench.py, then end-to-end), never assumed. G is the whole story: G <= 2
+// is almost certainly free, G ~ 10 starts zeroing weights that are 0.2% of the row max.
+//
+// CHOOSING phi (units: natural-log logit, i.e. max over the layer of (q . k) * softmax_scale
+// BEFORE log2 conversion -- the kernel multiplies by log2e itself, exactly like sm_scale).
+//   offline, per layer / per head, over a representative batch:
+//       phi_nat = max over (b, h, i) of max_j (q_i . k_j) * softmax_scale      # fp32 reference
+//       build with SAGE_H2_PHI=<phi_nat + margin>   (margin >= 0.5 nat is cheap: it costs
+//       0.72 octaves of e4m3 range and nothing else)
+//   The conservative closed form that needs no data is
+//       phi_nat <= head_dim * 127 * 127 * max(q_scale) * max(k_scale) * softmax_scale
+//   (int8 QK bound |S| <= 128*127*127 with the per-warp dequant scales applied). That bound is
+//   safe but typically 10+ octaves loose, which is exactly the regime where quality dies -- use
+//   it only as a sanity ceiling, not as phi.
+//
+// FAILURE MODE IF phi IS TOO SMALL. Nothing traps. For any element with S*scale > phi the exp2
+// argument exceeds S_FP8_OFFSET = 8.807, so P > 448 and halfx4_to_e4m3x4 SATURATES at 448
+// (cvt.rn.satfinite.e4m3x2.f32). The numerator and the denominator are then both clipped for that
+// row, in a way that no longer cancels: the row's attention collapses toward a uniform average of
+// the saturated keys, silently, with no NaN and no error. On top of that the fp16 PV accumulator
+// margin (CTA_K * 448 * v_scale_max < 65504) is computed assuming P <= 448, so a saturating build
+// is still inside its fp16 budget -- the corruption is purely in the softmax weights.
+// Build with -DSAGE_H2_SAT_CHECK=1 to get a one-shot printf per CTA when any lane saturates
+// (__any_sync over the warp); that macro is OFF by default so the timing path stays clean.
+//
+// The sm89 FP8 launchers take their CTA/warp tiling from these macros.
+// Override at build time with NVCC_APPEND_FLAGS="-DSAGE_H2_CTA_Q=64 -DSAGE_H2_CTA_K=64 -DSAGE_H2_WARP_Q=16".
+// cfg_base defaults: CTA_Q 128, CTA_K 64, WARP_Q 32, WARP_K 64 (upstream d1a57a5: 128/64/32/64).
+#pragma once
+
+#ifndef SAGE_H2_CTA_Q
+#define SAGE_H2_CTA_Q 128
+#endif
+#ifndef SAGE_H2_CTA_K
+#define SAGE_H2_CTA_K 64
+#endif
+#ifndef SAGE_H2_WARP_Q
+#define SAGE_H2_WARP_Q 32
+#endif
+
+// --- cfg_fixedmax switches -----------------------------------------------------------------
+// SAGE_H2_FIXED_MAX: 1 = replace the online max with the constant phi (this cfg).  0 = cfg_base.
+#ifndef SAGE_H2_FIXED_MAX
+#define SAGE_H2_FIXED_MAX 1
+#endif
+
+// SAGE_H2_PHI: phi in NATURAL-log logit units (see header comment). Override at build time with
+// SAGE_H2_PHI=12.5 (setup.py forwards it as -DSAGE_H2_PHI=12.5) or per run with the environment
+// variable SAGE_H2_PHI, which the launchers read and pass to the kernel as an argument -- so a
+// wrong phi costs one bench run, not one 26-minute rebuild.
+// Default 0.0f: with softmax_scale = 1/sqrt(128) and unit-variance q/k the max logit of a
+// 27k-key row sits around 4-5 nat, so 0.0f WILL saturate. It is deliberately a value that trips
+// SAGE_H2_SAT_CHECK rather than a guess that silently looks fine -- always set phi explicitly.
+#ifndef SAGE_H2_PHI
+#define SAGE_H2_PHI 0.0f
+#endif
+
+// SAGE_H2_SAT_CHECK: 1 = one printf per CTA when any lane's exp2 argument exceeds S_FP8_OFFSET
+// (i.e. P saturates at 448 => phi too small). Adds a compare + __any_sync per tile; keep OFF for
+// timing runs, turn ON once to validate a candidate phi.
+#ifndef SAGE_H2_SAT_CHECK
+#define SAGE_H2_SAT_CHECK 0
+#endif
+
+// SAGE_H2_DEP_NULL: 1 = cfg_depnull. Computes update_mdo's REAL row max (same S fragment, same
+// fk loop over every num_tiles_k fragment, same exp_offset fmaf, same two __shfl_xor_sync as
+// cfg_base) once per K tile, per (fq, k) row group, then sinks it through a volatile-asm
+// optimisation barrier -- the value never reaches RS, m, or d, so it cannot gate
+// apply_fixed_max's independent exp2 loop, which still runs unchanged. Timing only:
+// ms(cfg_depnull) close to ms(cfg_fixedmax) means the real max-tree's ALU work is free when it
+// is not on the critical path (the win is the dependency EDGE, not the instructions); close to
+// ms(cfg_base) means the ALU work costs cycles (register pressure / occupancy / issue-port
+// contention) even when disconnected, so C5's win is partly or wholly from deleting work, not
+// from breaking a dependency. See bench/attn/h2_tiles/README.md for the full prediction table.
+// Output is bit-identical to cfg_fixedmax (this macro adds a pure side computation with no
+// writes to RS/m/d); cosine/max-abs must match cfg_fixedmax exactly, or the sink leaked into the
+// real computation and the timing is uninterpretable. Meaningless without SAGE_H2_FIXED_MAX=1.
+// Default ON (this is cfg_depnull's own patch/cfg): SAGE_H2_DEP_NULL=0 reproduces cfg_fixedmax
+// byte-for-byte in the softmax path, the cheapest way to re-measure the pair on one clone.
+#ifndef SAGE_H2_DEP_NULL
+#define SAGE_H2_DEP_NULL 1
+#endif
+
+#if SAGE_H2_DEP_NULL && !SAGE_H2_FIXED_MAX
+#error "SAGE_H2_DEP_NULL requires SAGE_H2_FIXED_MAX=1 (it sinks a real max computed beside the fixed-phi exp2 path)"
+#endif
+
+#if SAGE_H2_FIXED_MAX
+// phi in base-2 units, resolved once per launch: environment variable SAGE_H2_PHI if set,
+// otherwise the compiled-in SAGE_H2_PHI. Host-side; the value is passed to the kernel as a
+// plain float argument (no signature change on any host/pybind entry point).
+#include <cstdlib>
+#include <cstring>
+inline float sage_h2_phi_log2()
+{
+  static const float cached = []() {
+    float phi_nat = static_cast<float>(SAGE_H2_PHI);
+    const char *e = std::getenv("SAGE_H2_PHI");
+    if (e && std::strlen(e) > 0) { phi_nat = static_cast<float>(std::atof(e)); }
+    return phi_nat * 1.44269504088896340736f;  // math::log2e
+  }();
+  return cached;
+}
+#else
+inline float sage_h2_phi_log2() { return 0.0f; }
+#endif
+
+// Constraints taken from qk_int_sv_f8_cuda_sm89.cuh / attn_utils.cuh / fused.cu (see h2_tiles/README.md).
+static_assert(SAGE_H2_CTA_K == 64 || SAGE_H2_CTA_K == 128, "V smem row = CTA_K bytes must be 64 or 128 (swizzle modes k64B/k128B)");
+static_assert(SAGE_H2_CTA_Q / SAGE_H2_CTA_K <= 2, "kernel static_assert(CTA_Q / CTA_K <= 2)");
+static_assert(SAGE_H2_WARP_Q == 16 || SAGE_H2_WARP_Q == 32, "quant_per_warp_int8_cuda only dispatches WARP_BLOCK_SIZE 16 or 32");
+static_assert(SAGE_H2_CTA_Q == 64 || SAGE_H2_CTA_Q == 128, "quant_per_warp_int8_cuda only dispatches BLOCK_SIZE 64 or 128");
+static_assert(SAGE_H2_CTA_Q % SAGE_H2_WARP_Q == 0, "WARP_Q must divide CTA_Q");
+static_assert(SAGE_H2_CTA_K % (SAGE_H2_CTA_Q / SAGE_H2_WARP_Q) == 0, "K tile rows must split evenly across the loading warps");
+static_assert(128 % ((SAGE_H2_CTA_Q / SAGE_H2_WARP_Q) * 4) == 0, "head_dim 128 V rows must split evenly across warps (4 rows per warp per iter)");
