+#if SAGE_H2_FIXED_MAX
+// cfg_fixedmax: the whole replacement for update_mdo.
+// P = exp2(S * sm_scale - phi_log2 + S_FP8_OFFSET), one independent fmaf+exp2 per element.
+// Gone vs update_mdo: the per-row max over num_tiles_k fragments, the two __shfl_xor_sync, the
+// m[][] read-modify-write, o_scale = exp2(m_prev - m_new), d *= o_scale, and the
+// num_tiles_v * 4 multiply RO rescale. Nothing here depends on any other element of the tile.
+// phi_log2 is a kernel argument (base-2 units) so it is uniform and lives in a constant-bank slot.
+template <uint32_t num_tiles_q, uint32_t num_tiles_k>
+__device__ __forceinline__ void apply_fixed_max(float RS[][num_tiles_k][8], const float &sm_scale, const float &phi_log2, bool &sat_warned)
+{
+  const float bias = S_FP8_OFFSET - phi_log2;
+#if SAGE_H2_SAT_CHECK
+  bool saturated = false;
+#endif
+#pragma unroll
+  for (uint32_t fq = 0; fq < num_tiles_q; fq++)
+  {
+#pragma unroll
+    for (uint32_t fk = 0; fk < num_tiles_k; fk++)
+    {
+#pragma unroll
+      for (uint32_t e = 0; e < 8; e++)
+      {
+        const float x = fmaf(RS[fq][fk][e], sm_scale, bias);
+#if SAGE_H2_SAT_CHECK
+        saturated |= (x > S_FP8_OFFSET);
+#endif
+        RS[fq][fk][e] = math::ptx_exp2(x);
+      }
+    }
+  }
+#if SAGE_H2_SAT_CHECK
+  // debug only: phi too small => P > 448 => halfx4_to_e4m3x4 clamps and the row is silently wrong.
+  // sat_warned is a per-thread flag owned by the kernel, so each warp reports at most once.
+  if (__any_sync(0xffffffff, saturated) && !sat_warned)
+  {
+    sat_warned = true;
+    if (get_lane_id() == 0)
+    {
+      printf("[SAGE_H2_SAT] phi too small: exp2 arg > S_FP8_OFFSET, P saturates at 448 "
+             "(block %u,%u,%u warp %u)\n", blockIdx.x, blockIdx.y, blockIdx.z, threadIdx.y);
+    }
+  }
+#else
+  (void)sat_warned;
+#endif
+}
+#endif  // SAGE_H2_FIXED_MAX
+
+#if SAGE_H2_DEP_NULL
+// cfg_depnull: update_mdo's REAL row-max computation, byte-for-byte the same fk loop over every
+// num_tiles_k S fragment, the same exp_offset=true/fuse_scale=false pre-shuffle fmaf, and the
+// same two __shfl_xor_sync as the exp_offset/fuse_scale instantiation qk_int_sv_f8_cuda_sm89.cuh
+// actually calls at all three of its update_mdo sites -- but the result is never written to RS,
+// m, or d. It cannot gate apply_fixed_max's exp2 loop because nothing connects them: this
+// function only reads RS (must run BEFORE apply_fixed_max, which overwrites RS in place with P)
+// and its only output is a dead local consumed by a volatile-asm barrier.
+//
+// WHY THE COMPILER CANNOT DELETE IT. __shfl_xor_sync is a convergent intrinsic with a sync side
+// effect, so NVVM must not sink, hoist, duplicate or remove it while its result is live.
+// asm volatile("" : "+f"(m_temp)) both reads and writes m_temp's register and is never deleted or
+// reordered against other volatile asm, so the whole producing chain (the fk-loop max tree, the
+// exp_offset fmaf, both shuffles) stays live up to the barrier. Unlike cfg_fixedmax_dep's
+// "bias + dummy*0" there is no arithmetic edge back into RS/exp2 at all afterwards -- the chain
+// is a dead end by construction, not a proven-zero contribution to a live value.
+//
+// WHAT THIS DOES NOT PROVE. ptxas is free to schedule this disconnected chain anywhere,
+// including fully overlapped with the next tile's mma.sync or cp.async wait -- freedom cfg_base's
+// real chain does not have, because there the exp2 is a true consumer of m[fq][k]. A "no
+// slowdown vs cfg_fixedmax" result is therefore an upper bound on what a dependency-preserving
+// restructure could recover, not proof one would reach it in practice (a real restructure must
+// eventually use the max for something, e.g. a correction pass, which can reintroduce cost this
+// sink never pays). See bench/attn/h2_tiles/README.md.
+template <uint32_t num_tiles_q, uint32_t num_tiles_k>
+__device__ __forceinline__ void sink_real_max_dep_null(float RS[][num_tiles_k][8], const float &sm_scale)
+{
+#pragma unroll
+  for (uint32_t fq = 0; fq < num_tiles_q; fq++)
+  {
+#pragma unroll
+    for (uint32_t k = 0; k < 2; k++)
+    {
+      // same seed and same fk-loop reduction as update_mdo's m_temp (all num_tiles_k fragments,
+      // elements {k*2+0, k*2+1, k*2+4, k*2+5} -- update_mdo's own indexing, not a subset of it)
+      float m_temp = -5000000.0f;
+#pragma unroll
+      for (uint32_t fk = 0; fk < num_tiles_k; fk++)
+      {
+        float m_local = max(max(RS[fq][fk][k * 2 + 0], RS[fq][fk][k * 2 + 1]),
+                             max(RS[fq][fk][k * 2 + 4], RS[fq][fk][k * 2 + 5]));
+        m_temp = max(m_temp, m_local);
+      }
+      // exp_offset=true, fuse_scale=false: the pre-shuffle transform update_mdo applies in the
+      // instantiation the sm89 kernels call (qk_int_sv_f8_cuda_sm89.cuh: <..., false, true, false>
+      // and <..., true, true, false> at all three update_mdo call sites).
+      m_temp = fmaf(m_temp, sm_scale, -S_FP8_OFFSET);
+      // the same two butterfly steps, same mask, same widths, same op as update_mdo's reduction
+      m_temp = max(m_temp, __shfl_xor_sync(0xffffffff, m_temp, 0x1)); // 0 exchange with 1, 2 exchange with 3
+      m_temp = max(m_temp, __shfl_xor_sync(0xffffffff, m_temp, 0x2)); // 0 exchange with 2, 1 exchange with 3
+      // sink: keeps the chain live without letting it reach RS/m/d.
+      asm volatile("" : "+f"(m_temp));
+    }
+  }
+}
+#endif  // SAGE_H2_DEP_NULL
+
