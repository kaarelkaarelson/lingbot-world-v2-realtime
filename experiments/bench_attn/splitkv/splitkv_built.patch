+// Merges the num_splits partials of qk_int_sv_f8_attn_kernel<..., split_kv=true> (flash-decoding combine).
+// One warp per query row; each lane owns 4 consecutive channels. m is in the kernel's log2 domain (incl. S_FP8_OFFSET).
+template<uint32_t head_dim, typename DTypeOut, bool fuse_v_scale>
+__global__ void splitkv_combine_kernel(const float *__restrict__ O_part, const float2 *__restrict__ ML_part, const float *__restrict__ V_scale,
+                                       DTypeOut *__restrict__ O,
+                                       const uint32_t qo_len, const uint32_t num_splits, const uint32_t num_kv_groups,
+                                       const uint32_t stride_bz_o, const uint32_t stride_seq_o, const uint32_t stride_h_o)
+{
+  static_assert(head_dim % 4 == 0);
+  const uint32_t row = blockIdx.x * blockDim.y + threadIdx.y;
+  if (row >= qo_len)
+  {
+    return;
+  }
+  const uint32_t head_id = blockIdx.y;
+  const uint32_t num_qo_heads = gridDim.y;
+  const uint32_t batch_id = blockIdx.z;
+  const size_t split_stride = (size_t)gridDim.z * num_qo_heads * qo_len; // rows per split
+  const size_t row_idx = ((size_t)batch_id * num_qo_heads + head_id) * qo_len + row;
 
+  float m = -INFINITY;
+  for (uint32_t s = 0; s < num_splits; s++)
+  {
+    m = max(m, ML_part[s * split_stride + row_idx].x);
+  }
+  float l = 0.0f;
+  for (uint32_t s = 0; s < num_splits; s++)
+  {
+    const float2 ml = ML_part[s * split_stride + row_idx];
+    l += math::ptx_exp2(ml.x - m) * ml.y;
+  }
+  const float l_rcp = math::ptx_rcp(l);
 
+  DTypeOut *O_row = O + batch_id * stride_bz_o + head_id * stride_h_o + row * stride_seq_o;
+  for (uint32_t c = threadIdx.x * 4; c < head_dim; c += 32 * 4)
+  {
+    float4 acc = make_float4(0.f, 0.f, 0.f, 0.f);
+    for (uint32_t s = 0; s < num_splits; s++)
+    {
+      const float w = math::ptx_exp2(ML_part[s * split_stride + row_idx].x - m);
+      const float4 o = *(const float4*)(O_part + (s * split_stride + row_idx) * head_dim + c);
+      acc.x += w * o.x;
+      acc.y += w * o.y;
+      acc.z += w * o.z;
+      acc.w += w * o.w;
+    }
+    acc.x *= l_rcp; acc.y *= l_rcp; acc.z *= l_rcp; acc.w *= l_rcp;
 
+    if constexpr (fuse_v_scale)
+    {
+      const float4 vs = *(const float4*)(V_scale + (batch_id * (num_qo_heads / num_kv_groups) + head_id / num_kv_groups) * head_dim + c);
+      acc.x *= vs.x; acc.y *= vs.y; acc.z *= vs.z; acc.w *= vs.w;
+    }
 
-
+    uint32_t packed[2];
+    if constexpr (std::is_same<DTypeOut, half>::value)
+    {
+      ((half2*)packed)[0] = __float22half2_rn(make_float2(acc.x, acc.y));
+      ((half2*)packed)[1] = __float22half2_rn(make_float2(acc.z, acc.w));
+    }
+    else
+    {
+      ((nv_bfloat162*)packed)[0] = __float22bfloat162_rn(make_float2(acc.x, acc.y));
+      ((nv_bfloat162*)packed)[1] = __float22bfloat162_rn(make_float2(acc.z, acc.w));
+    }
+    *(uint2*)(O_row + c) = make_uint2(packed[0], packed[1]);
+  }
+}
