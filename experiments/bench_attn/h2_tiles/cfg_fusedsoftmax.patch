@@ -41,6 +42,97 @@
 #define MMA_SV_N 16
 #define MMA_SV_K 32
 
+#ifdef SAGE_H2_FUSED_SOFTMAX
+__device__ __forceinline__ float h2_i2f(int32_t x)
+{
+#if SAGE_H2_I2F_MAGIC
+  // exact for -2^22 <= x <= 2^22: (1.5*2^23 + x) is representable with ulp 1, the subtraction is exact
+  return __int_as_float(x + 0x4B400000) - 12582912.0f;
+#else
+  return __int2float_rz(x);
+#endif
+}
+
+// Steady-state K step softmax for DTypeSVAccum = float, exp_offset = true, fuse_scale = false, denominator on CUDA
+// cores. Replaces (in this order, bit for bit): RS_f32 = __int2float_rz(RS); update_mdo<nq, nk, nv, false, true, false>;
+// accumulate_d<nq, nk, kCudaCore>; RS_32_to_8. Two sweeps over the S fragment instead of five.
+template <uint32_t num_tiles_q, uint32_t num_tiles_k, uint32_t num_tiles_v>
+__device__ __forceinline__ void h2_fused_softmax_quant(int32_t RS[][num_tiles_k][8], float RO[][num_tiles_v][8],
+                                                       float m[][2], float d[][2],
+                                                       uint32_t RS_f8[][num_tiles_k / 2][4], const float sm_scale)
+{
+  float RS_f32[num_tiles_q][num_tiles_k][8];
+  float m_local[num_tiles_q][2];
+
+  // sweep 1: int32 -> fp32 and thread-local row max (max is exact, so the fold order does not matter)
+#pragma unroll
+  for (uint32_t fq = 0; fq < num_tiles_q; fq++)
+  {
+    m_local[fq][0] = -5000000.0f;
+    m_local[fq][1] = -5000000.0f;
+#pragma unroll
+    for (uint32_t fk = 0; fk < num_tiles_k; fk++)
+    {
+#pragma unroll
+      for (uint32_t k = 0; k < 8; k++)
+      {
+        float v = h2_i2f(RS[fq][fk][k]);
+        RS_f32[fq][fk][k] = v;
+        m_local[fq][(k % 4) / 2] = max(m_local[fq][(k % 4) / 2], v);
+      }
+    }
+  }
+
+  // row max across the 4 lanes of a row (2 shuffles per row group, as update_mdo), then rescale d and O
+  float negative_m[num_tiles_q][2];
+#pragma unroll
+  for (uint32_t fq = 0; fq < num_tiles_q; fq++)
+  {
+#pragma unroll
+    for (uint32_t k = 0; k < 2; k++)
+    {
+      float m_prev = m[fq][k];
+      float m_temp = fmaf(m_local[fq][k], sm_scale, -S_FP8_OFFSET);
+      m_temp = max(m_temp, __shfl_xor_sync(0xffffffff, m_temp, 0x1));
+      m_temp = max(m_temp, __shfl_xor_sync(0xffffffff, m_temp, 0x2));
+      m[fq][k] = max(m[fq][k], m_temp);
+      negative_m[fq][k] = -m[fq][k];
+
+      float o_scale = math::ptx_exp2(m_prev - m[fq][k]);
+      d[fq][k] *= o_scale;
+#pragma unroll
+      for (uint32_t fv = 0; fv < num_tiles_v; fv++)
+      {
+        RO[fq][fv][k * 2 + 0] *= o_scale;
+        RO[fq][fv][k * 2 + 1] *= o_scale;
+        RO[fq][fv][k * 2 + 4] *= o_scale;
+        RO[fq][fv][k * 2 + 5] *= o_scale;
+      }
+    }
+  }
+
+  // sweep 2: exp2, row sum (same association as accumulate_d), packed e4m3x2 convert (same helper as RS_32_to_8)
+#pragma unroll
+  for (uint32_t fq = 0; fq < num_tiles_q; fq++)
+  {
+#pragma unroll
+    for (uint32_t fk = 0; fk < num_tiles_k; fk++)
+    {
+      float p[8];
+#pragma unroll
+      for (uint32_t k = 0; k < 8; k++)
+      {
+        p[k] = math::ptx_exp2(fmaf(RS_f32[fq][fk][k], sm_scale, negative_m[fq][(k % 4) / 2]));
+      }
+      d[fq][0] += p[0] + p[1] + p[4] + p[5];
+      d[fq][1] += p[2] + p[3] + p[6] + p[7];
+      floatx4_to_e4m3x4(RS_f8[fq][fk / 2] + (fk % 2) * 2 + 0, p + 0, p + 4);
+      floatx4_to_e4m3x4(RS_f8[fq][fk / 2] + (fk % 2) * 2 + 1, p + 2, p + 6);
+    }
+  }
+}
+#endif  // SAGE_H2_FUSED_SOFTMAX
