+#endif
     float RS_f32[num_tiles_q][num_tiles_k][8];
 
 #pragma unroll
@@ -316,13 +421,18 @@
       accumulate_d<num_tiles_q, num_tiles_k, ComputeUnit::kCudaCore>(RS_f32, d);
     }
 
+#ifndef SAGE_H2_FUSED_SOFTMAX
