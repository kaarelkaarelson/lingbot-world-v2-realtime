     if constexpr (DenominatorAccumUnit == ComputeUnit::kTensorCore)
     {
       accumulate_d_f8<num_tiles_q, num_tiles_k>(RS_f8, d);
     }
+#ifdef SAGE_H2_FUSED_SOFTMAX
