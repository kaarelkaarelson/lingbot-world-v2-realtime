diff -ruN --exclude=.git a/csrc/qattn/h2_tiles.h b/csrc/qattn/h2_tiles.h
--- a/csrc/qattn/h2_tiles.h	1969-12-31 16:00:00
+++ b/csrc/qattn/h2_tiles.h	2026-09-22 01:18:57
@@ -0,0 +1,44 @@
+// H2 tile-size experiment: the sm89 FP8 launchers take their CTA/warp tiling from these macros.
+// Override at build time with NVCC_APPEND_FLAGS="-DSAGE_H2_CTA_Q=64 -DSAGE_H2_CTA_K=64 -DSAGE_H2_WARP_Q=16".
+// cfg_condrescale: upstream tiles (CTA_Q 128, CTA_K 64, WARP_Q 32, WARP_K 64) plus FlashAttention-4 style
+// conditional rescaling of the online softmax (SAGE_H2_COND_RESCALE / SAGE_H2_RESCALE_TAU below).
+#pragma once
+
+#ifndef SAGE_H2_CTA_Q
+#define SAGE_H2_CTA_Q 128
+#endif
+#ifndef SAGE_H2_CTA_K
+#define SAGE_H2_CTA_K 64
+#endif
+#ifndef SAGE_H2_WARP_Q
+#define SAGE_H2_WARP_Q 32
+#endif
+
+// Constraints taken from qk_int_sv_f8_cuda_sm89.cuh / attn_utils.cuh / fused.cu (see h2_tiles/README.md).
+static_assert(SAGE_H2_CTA_K == 64 || SAGE_H2_CTA_K == 128, "V smem row = CTA_K bytes must be 64 or 128 (swizzle modes k64B/k128B)");
+static_assert(SAGE_H2_CTA_Q / SAGE_H2_CTA_K <= 2, "kernel static_assert(CTA_Q / CTA_K <= 2)");
+static_assert(SAGE_H2_WARP_Q == 16 || SAGE_H2_WARP_Q == 32, "quant_per_warp_int8_cuda only dispatches WARP_BLOCK_SIZE 16 or 32");
+static_assert(SAGE_H2_CTA_Q == 64 || SAGE_H2_CTA_Q == 128, "quant_per_warp_int8_cuda only dispatches BLOCK_SIZE 64 or 128");
+static_assert(SAGE_H2_CTA_Q % SAGE_H2_WARP_Q == 0, "WARP_Q must divide CTA_Q");
+static_assert(SAGE_H2_CTA_K % (SAGE_H2_CTA_Q / SAGE_H2_WARP_Q) == 0, "K tile rows must split evenly across the loading warps");
+static_assert(128 % ((SAGE_H2_CTA_Q / SAGE_H2_WARP_Q) * 4) == 0, "head_dim 128 V rows must split evenly across warps (4 rows per warp per iter)");
+
+// Candidate C2 -- conditional rescaling (FlashAttention-4, arXiv:2603.05451): update_mdo in attn_utils.cuh keeps a
+// stale row max and only rescales O and d (exp2(m_stale - m_new), 128 fp32 multiplies per thread) when the tile's
+// row max exceeds the stale max by more than SAGE_H2_RESCALE_TAU (log2 units). The multiply loop is skipped only when
+// no row of the warp rescales (__any_sync), so the branch is warp-uniform.
+//
+// Why tau is not free here: upstream subtracts S_FP8_OFFSET = 8.807 = log2(448) from the max, so P = exp2(S - m) already
+// spans the full fp8 e4m3 range (max 448, cvt.rn.satfinite would clip anything above) and the fp16 PV accumulator
+// budget is 64 keys * 448 * V<=2.25 = 64512 < 65504. A max that is stale by tau makes P up to 2^tau larger, so with
+// the upstream offset the only safe value is tau = 0. To allow tau > 0 the offset is lowered by tau
+// (P <= 448 / 2^tau right after a rescale, <= 448 when the max is stale by tau), which keeps both the fp8 range and
+// the fp16 accumulator budget exactly as upstream but drops tau bits from the bottom of the fp8 range: weights
+// below 2^-9 / (448 / 2^tau) of the row max (1.7e-5 at tau = 2, 4.4e-6 upstream) flush to zero in P (d is summed
+// from the fp32 P, so it is unaffected). tau = 0 is bit-exact with upstream and still skips every tile whose max
+// did not move. Override with NVCC_APPEND_FLAGS="-DSAGE_H2_RESCALE_TAU=0.0f".
+#define SAGE_H2_COND_RESCALE 1
+#ifndef SAGE_H2_RESCALE_TAU
+#define SAGE_H2_RESCALE_TAU 2.0f
+#endif
+static_assert(SAGE_H2_RESCALE_TAU >= 0.0f && SAGE_H2_RESCALE_TAU <= 8.0f, "tau must be in [0, 8] log2 units (offset 8.807 - tau must stay positive)");
