+#include "h2_tiles.h"  // SAGE_H2_PACKED_EXP, SAGE_H2_PACKED_EXP_ARG
 
 #define WARP_SIZE 32
 
@@ -435,6 +436,60 @@ __device__ __forceinline__ void update_mdo(float RS[][num_tiles_k][8], DTypeSVAc
 
       // raise RS to exponent
       float negative_m = -m[fq][k];
+#if SAGE_H2_PACKED_EXP
+      // C6: one ex2.approx.f16x2 per adjacent pair instead of two ex2.approx.f32, halving the softmax's
+      // MUFU issue slots. The natural pairs are elements {0,1} and {4,5} of each fragment (the same four
+      // elements the scalar path below touches). Argument <= S_FP8_OFFSET = 8.807 and result in [0, 448],
+      // both far inside fp16; RS stays fp32 because accumulate_d and RS_32_to_8 read fp32. See h2_tiles.h
+      // for the range/precision analysis -- this is NOT bit-identical to the scalar path.
+#if SAGE_H2_PACKED_EXP_ARG
+      const half2 sm_scale_h2 = __float2half2_rn(sm_scale);
+      const half2 negative_m_h2 = __float2half2_rn(negative_m);
+#endif
+#pragma unroll
+      for (uint32_t fk = 0; fk < num_tiles_k; fk++)
+      {
+        half2 e01, e45;
+#if SAGE_H2_PACKED_EXP_ARG
+        // fully packed argument: see the WARNING in h2_tiles.h (raw RS can exceed fp16's range)
+        const half2 a01 = __floats2half2_rn(RS[fq][fk][k * 2 + 0], RS[fq][fk][k * 2 + 1]);
+        const half2 a45 = __floats2half2_rn(RS[fq][fk][k * 2 + 4], RS[fq][fk][k * 2 + 5]);
+        if constexpr (fuse_scale)
+        {
+          e01 = math::ptx_exp2(__hadd2(a01, negative_m_h2));
+          e45 = math::ptx_exp2(__hadd2(a45, negative_m_h2));
+        }
+        else
+        {
+          e01 = math::ptx_exp2(__hfma2(a01, sm_scale_h2, negative_m_h2));
+          e45 = math::ptx_exp2(__hfma2(a45, sm_scale_h2, negative_m_h2));
+        }
+#else
+        // argument in fp32 (exact as upstream), only the exponential is packed
+        float x0, x1, x4, x5;
+        if constexpr (fuse_scale)
+        {
+          x0 = RS[fq][fk][k * 2 + 0] + negative_m;
+          x1 = RS[fq][fk][k * 2 + 1] + negative_m;
+          x4 = RS[fq][fk][k * 2 + 4] + negative_m;
+          x5 = RS[fq][fk][k * 2 + 5] + negative_m;
+        }
+        else
+        {
+          x0 = fmaf(RS[fq][fk][k * 2 + 0], sm_scale, negative_m);
+          x1 = fmaf(RS[fq][fk][k * 2 + 1], sm_scale, negative_m);
+          x4 = fmaf(RS[fq][fk][k * 2 + 4], sm_scale, negative_m);
+          x5 = fmaf(RS[fq][fk][k * 2 + 5], sm_scale, negative_m);
+        }
+        e01 = math::ptx_exp2(__floats2half2_rn(x0, x1));
+        e45 = math::ptx_exp2(__floats2half2_rn(x4, x5));
+#endif
+        RS[fq][fk][k * 2 + 0] = __low2float(e01);
+        RS[fq][fk][k * 2 + 1] = __high2float(e01);
+        RS[fq][fk][k * 2 + 4] = __low2float(e45);
+        RS[fq][fk][k * 2 + 5] = __high2float(e45);
+      }
+#else
 #pragma unroll
       for (uint32_t fk = 0; fk < num_tiles_k; fk++)
       {
@@ -453,6 +508,7 @@ __device__ __forceinline__ void update_mdo(float RS[][num_tiles_k][8], DTypeSVAc
           RS[fq][fk][k * 2 + 5] = math::ptx_exp2(fmaf(RS[fq][fk][k * 2 + 5], sm_scale, negative_m));
         }
