diff --git a/csrc/qattn/h2_tiles.h b/csrc/qattn/h2_tiles.h
new file mode 100644
index 0000000..0d7180f
--- /dev/null
+++ b/csrc/qattn/h2_tiles.h
@@ -0,0 +1,74 @@
+// H2 tile-size experiment: the sm89 FP8 launchers take their CTA/warp tiling from these macros.
+// Override at build time with NVCC_APPEND_FLAGS="-DSAGE_H2_CTA_Q=64 -DSAGE_H2_CTA_K=64 -DSAGE_H2_WARP_Q=16".
+// cfg_packedexp: upstream tiles (CTA_Q 128, CTA_K 64, WARP_Q 32, WARP_K 64) plus the packed half2
+// exponential in update_mdo (attn_utils.cuh): one ex2.approx.f16x2 for every two softmax exponentials
+// instead of two ex2.approx.f32, halving the SFU/MUFU issue slots of the softmax.
+#pragma once
+
+#ifndef SAGE_H2_CTA_Q
+#define SAGE_H2_CTA_Q 128
+#endif
+#ifndef SAGE_H2_CTA_K
+#define SAGE_H2_CTA_K 64
+#endif
+#ifndef SAGE_H2_WARP_Q
+#define SAGE_H2_WARP_Q 32
+#endif
+
+// Constraints taken from qk_int_sv_f8_cuda_sm89.cuh / attn_utils.cuh / fused.cu (see h2_tiles/README.md).
+static_assert(SAGE_H2_CTA_K == 64 || SAGE_H2_CTA_K == 128, "V smem row = CTA_K bytes must be 64 or 128 (swizzle modes k64B/k128B)");
+static_assert(SAGE_H2_CTA_Q / SAGE_H2_CTA_K <= 2, "kernel static_assert(CTA_Q / CTA_K <= 2)");
+static_assert(SAGE_H2_WARP_Q == 16 || SAGE_H2_WARP_Q == 32, "quant_per_warp_int8_cuda only dispatches WARP_BLOCK_SIZE 16 or 32");
+static_assert(SAGE_H2_CTA_Q == 64 || SAGE_H2_CTA_Q == 128, "quant_per_warp_int8_cuda only dispatches BLOCK_SIZE 64 or 128");
+static_assert(SAGE_H2_CTA_Q % SAGE_H2_WARP_Q == 0, "WARP_Q must divide CTA_Q");
+static_assert(SAGE_H2_CTA_K % (SAGE_H2_CTA_Q / SAGE_H2_WARP_Q) == 0, "K tile rows must split evenly across the loading warps");
+static_assert(128 % ((SAGE_H2_CTA_Q / SAGE_H2_WARP_Q) * 4) == 0, "head_dim 128 V rows must split evenly across warps (4 rows per warp per iter)");
+
+// ---------------------------------------------------------------------------------------------------
+// C6: packed half-precision exponential.
+//
+// SAGE_H2_PACKED_EXP (on by default in this cfg): in update_mdo the four scalar
+//   RS = ex2.approx.ftz.f32(fmaf(RS, sm_scale, -m))
+// per (fragment, row-half) become two
+//   half2 = ex2.approx.f16x2(cvt.rn.f16x2.f32(x_a, x_b))
+// The fmaf that builds the argument stays in fp32; only the exponential itself is packed. RS keeps its
+// fp32 storage type (accumulate_d and RS_32_to_8 downstream both read fp32), so the results are converted
+// back with __low2float/__high2float. Per row-half and per warp this turns 16 MUFU ops into 8.
+//
+// Range (all bounds from this kernel, head_dim 128, e4m3 P):
+//   argument x = S*sm_scale - m  <=  S_FP8_OFFSET = 8.807  (m carries the -S_FP8_OFFSET offset), and in
+//   practice x >= about -20; result P = 2^x in [0, 448]. fp16 holds [6.1e-5 (min normal) .. 65504], so
+//   both ends are comfortably inside: the largest P (448) is 146x below fp16's max, and the smallest P
+//   that survives the very next step is e4m3's min subnormal 2^-9 = 1.95e-3, which is 32x ABOVE fp16's
+//   min normal -- i.e. every P that the fp8 conversion can represent at all is a normal fp16.
+// Precision (this is NOT bit-identical to the baseline):
+//   fp16 has 10 stored mantissa bits vs fp32's 23. The argument is rounded to fp16 first: near |x| = 8.8
+//   the fp16 ulp is 2^3 * 2^-10 = 7.8e-3, so the half-ulp argument error <= 3.9e-3, i.e. a relative error
+//   in P of 2^0.0039 - 1 = 0.27%; near x = -20 it is 0.54%, but those P are ~1e-6 and carry no weight.
+//   The result is then rounded to fp16 again (2^-11 = 0.05% relative). Both are small next to the e4m3
+//   conversion that immediately follows (3 stored mantissa bits -> 6.25% half-ulp relative quantisation),
+//   and the row sum d is accumulated from the same perturbed P, so numerator and denominator move together.
+//   Expected effect on the harness cosine: small. Acceptance gate is cosine >= the baseline's 0.999246.
+//
+// SAGE_H2_PACKED_EXP_ARG (opt-in, NOT defined here -- build with
+//   NVCC_APPEND_FLAGS="-DSAGE_H2_PACKED_EXP_ARG=1"):
+// the riskier, fully packed variant -- the argument is built with __hfma2/__hadd2 in half2 as well, so
+// 2 FFMA + 1 cvt.rn.f16x2.f32 per pair collapse into 1 cvt + 1 HFMA2.
+// WARNING, read before benching: all three update_mdo call sites in qk_int_sv_f8_cuda_sm89.cuh pass
+// fuse_scale = false, so RS at this point is the RAW int8 QK accumulator turned into float
+// (__int2float_rz), whose magnitude is bounded only by head_dim * 127 * 127 = 2.06e6. Converting that to
+// fp16 before the scale overflows to +-inf whenever a row's peak accumulator exceeds 65504, and
+// exp2(+inf) = inf poisons the whole tile. It is therefore correct only on data whose int8 QK
+// accumulators stay under 65504; it is provided because it is the upper bound on what packing can save,
+// and the harness's cosine check will expose it immediately if the bound is violated. Making it safe
+// would require folding a power-of-two shrink into the __int2float_rz in qk_int_sv_f8_cuda_sm89.cuh,
+// which is deliberately out of scope for this patch.
+#ifndef SAGE_H2_PACKED_EXP
+#define SAGE_H2_PACKED_EXP 1
+#endif
+#ifndef SAGE_H2_PACKED_EXP_ARG
+#define SAGE_H2_PACKED_EXP_ARG 0
+#endif
+#if SAGE_H2_PACKED_EXP_ARG && !SAGE_H2_PACKED_EXP
+#error "SAGE_H2_PACKED_EXP_ARG=1 requires SAGE_H2_PACKED_EXP=1"
+#endif
